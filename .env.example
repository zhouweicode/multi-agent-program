# auto：存在 Key 时使用 GLM-5.2，无 Key 时自动回退 Mock。
MODEL_PROVIDER=auto
MODEL_NAME=glm-5.2
MODEL_API_KEY=your-glm-api-key
MODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
MODEL_TEMPERATURE=0
MODEL_REQUEST_TIMEOUT=60
MODEL_MAX_RETRIES=1

# Agent Harness 全局运行策略；0 表示 Token/成本预算不限。
AGENT_MAX_STEPS=12
AGENT_MAX_TOOL_CALLS=16
AGENT_MAX_DURATION_SECONDS=120
AGENT_MAX_TOKENS=0
AGENT_MAX_COST=0
AGENT_MODEL_TIMEOUT_SECONDS=65
AGENT_MODEL_MAX_RETRIES=1
AGENT_TOOL_TIMEOUT_SECONDS=30
AGENT_TOOL_MAX_RETRIES=1
AGENT_RETRY_BASE_SECONDS=0.05
AGENT_RETRY_MAX_SECONDS=2
AGENT_RETRY_JITTER_SECONDS=0.05
AGENT_CIRCUIT_BREAKER_THRESHOLD=5
AGENT_CIRCUIT_BREAKER_RESET_SECONDS=30
AGENT_PARALLEL_TOOL_CALLS=true
AGENT_MAX_PARALLEL_TOOLS=4
AGENT_OBSERVATION_MAX_CHARS=8000
AGENT_OBSERVATION_MAX_ITEMS=50
AGENT_LOOP_REPEAT_THRESHOLD=3
AGENT_NO_PROGRESS_THRESHOLD=3

# 任意配置均可按 Agent 覆盖；名称前缀采用大写 Agent 名。
# ACHIEVEMENT_AGENT_MODEL_NAME=glm-5.2
# ACHIEVEMENT_AGENT_MAX_TOKENS=32000
# WEB_RESEARCH_AGENT_TOOL_TIMEOUT_SECONDS=15
# VERIFICATION_AGENT_MODEL_NAME=glm-5.2

# 第七阶段轨迹限制；默认不把完整 State 写入服务日志。
TRACE_MAX_THREADS=100
TRACE_MAX_EVENTS_PER_THREAD=200
TRACE_MAX_SNAPSHOT_CHARS=200000
TRACE_LOG_PAYLOADS=false

# 后台 Run 治理与持久化 Registry
RUN_MAX_WORKERS=4
RUN_TIMEOUT_SECONDS=300
RUN_REGISTRY_PATH=.runtime/runs.sqlite
KG_WORKFLOW_REGISTRY_PATH=.runtime/kg-workflow.sqlite

# 本地多用户登录。三个密码只在首次创建 users.sqlite 时用于初始化，之后修改环境变量不会重置密码。
# 这些是开发演示密码；对外部署前必须替换，并在 HTTPS 环境设置 AUTH_COOKIE_SECURE=true。
AUTH_REQUIRED=true
AUTH_DB_PATH=.runtime/users.sqlite
AUTH_SESSION_TTL_SECONDS=86400
AUTH_COOKIE_SECURE=false
AUTH_ADMIN_PASSWORD=Admin@123
AUTH_RESEARCHER_PASSWORD=Research@123
AUTH_ANALYST_PASSWORD=Analyst@123

# Agent Tool传输：local为进程内LangChain Tool；mcp为远端MCP Server动态发现与调用。
TOOL_TRANSPORT=local
# 可按领域覆盖；默认仍全部Local。显式配置Web MCP Server后，WebResearchAgent会优先MCP，
# 如需关闭该行为可设置 {"web":"local"}。
TOOL_TRANSPORT_OVERRIDES_JSON={}
MCP_SERVER_URL=http://127.0.0.1:8100/mcp
MCP_REQUEST_TIMEOUT=30
# 多Server控制面。每个Server应声明领域、Tool白名单和唯一前缀；未配置时兼容上面的单Server URL。
# MCP_SERVERS_JSON={"public_web":{"url":"https://mcp.example.com/mcp","domains":["web"],"allowed_tools":["search_web"],"tool_prefix":"external"}}
# MCP Server自身监听配置；默认只绑定回环地址，禁止无鉴权暴露到公网。
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8100
MCP_SERVER_PATH=/mcp

# Skill只从仓库skills/*/SKILL.md发现；运行时启停状态写入该文件。
SKILL_CONFIG_PATH=.runtime/skills.json

# 联网搜索由MCP Server和local web工具共享。disabled不联网；也可配置brave或tavily。
WEB_SEARCH_PROVIDER=disabled
WEB_SEARCH_API_KEY=
# 留空使用Provider官方Endpoint；私有网关场景才覆盖。
WEB_SEARCH_ENDPOINT=
WEB_SEARCH_TIMEOUT=15
WEB_SEARCH_MAX_RESULTS=5

# AgentOps / observability. Configure provider prices to calculate per-run cost.
OBSERVABILITY_DB_PATH=.runtime/observability.sqlite
# 生产使用 mysql；开发和自动化测试可使用 sqlite。
MEMORY_BACKEND=mysql
# 记忆运行数据与 gkx 知识数据分库，MySQL 适配器会幂等创建数据库和表。
MEMORY_MYSQL_DATABASE=gkx_runtime
MEMORY_EXTRACTION_ENABLED=true
MEMORY_WORKER_POLL_SECONDS=1
MEMORY_WORKER_BATCH_SIZE=10
MEMORY_WORKER_LEASE_SECONDS=60
MEMORY_WORKER_MAX_ATTEMPTS=3
MEMORY_FACT_CONFIDENCE_THRESHOLD=0.85
MEMORY_FACT_MAX_PER_SCOPE=100
MEMORY_FACT_REVIEW_DAYS=90
MEMORY_FACT_SIMILARITY_THRESHOLD=0.86
MEMORY_RECALL_TOP_K=5
MEMORY_RECALL_CANDIDATE_LIMIT=100
MEMORY_RECALL_TOKEN_BUDGET=1000
# 长期记忆向量索引必须使用独立文件和集合，不能与专家实体集合混用。
MEMORY_MILVUS_URI=.runtime/user-memory-milvus.db
MEMORY_MILVUS_COLLECTION=user_memory_facts_v1
MEMORY_RETRIEVAL_BACKEND=hybrid
# 对话记忆属于可独立清除的运行数据，不写入知识图谱数据库。
CONVERSATION_MEMORY_DB_PATH=.runtime/conversation-memory.sqlite
LONG_TERM_MEMORY_DB_PATH=.runtime/long-term-memory.sqlite

# 查询经验分级：shadow 只观测；advisory 附加白名单 Tool 建议；active 还可在
# 当前 Router 结果一致时调整同一安全任务集合的顺序。三种模式都不跳过 Validator。
QUERY_EXPERIENCE_DB_PATH=.runtime/query-experience.sqlite
QUERY_EXPERIENCE_MODE=shadow
# 脱敏且通过校验的成功经验进入该全局命名空间；私有经验按登录 user_id 自动隔离。
QUERY_EXPERIENCE_SCOPE_ID=local
QUERY_EXPERIENCE_CANDIDATE_LIMIT=5
QUERY_EXPERIENCE_MIN_SAMPLES=5
QUERY_EXPERIENCE_MIN_SIMILARITY=0.72
QUERY_EXPERIENCE_MIN_CONFIDENCE=0.75
WORKFLOW_VERSION=stage13-agent-runtime
PROMPT_VERSION=prompt-v1
MODEL_INPUT_COST_PER_MILLION=8
MODEL_OUTPUT_COST_PER_MILLION=28
MODEL_COST_CURRENCY=CNY

# API 持久化检查点位置
CHECKPOINT_DB_PATH=.runtime/checkpoints.sqlite

# 数据后端默认保持 mock；按领域渐进切换。
ENTITY_BACKEND=hybrid
ENTITY_CANDIDATE_TOP_K=10
ENTITY_AUTO_RESOLVE_THRESHOLD=0.90
ENTITY_SCORE_GAP_THRESHOLD=0.15
ENTITY_VECTOR_MIN_SCORE=0.02
ACHIEVEMENT_BACKEND=mock
GRAPH_BACKEND=mock
# 企业与产业后端设为 neo4j 时复用 GRAPH_BACKEND 创建的同一 Driver。
ENTERPRISE_BACKEND=mock
INDUSTRY_BACKEND=mock

# MySQL gkx（密码只放本机 .env 或进程环境，绝不能提交）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=gkx
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password

# 合成数据建议使用独立库；导入脚本优先读取此密码，并拒绝写入 gkx。
SYNTHETIC_MYSQL_PASSWORD=your-local-synthetic-mysql-password

# Neo4j
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=gkx
NEO4J_MANAGED_ONLY=false

# 第六阶段：Embedding 与 Milvus Lite Hybrid Search
EMBEDDING_PROVIDER=bge_m3
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
HF_HOME=.runtime/huggingface
EMBEDDING_CACHE_DIR=.runtime/huggingface
# 避免使用 pymilvus 自己占用的 MILVUS_URI；项目使用独立变量名。
GRAPHRAG_MILVUS_URI=.runtime/milvus-bge-m3.db
MILVUS_COLLECTION=scholar_entities
MILVUS_RRF_K=60
# Standalone/Zilliz Cloud 才需要 Token；Lite 留空。
MILVUS_TOKEN=
