# auto：存在 Key 时使用 GLM-5.2，无 Key 时自动回退 Mock。
MODEL_PROVIDER=auto
MODEL_NAME=glm-5.2
MODEL_API_KEY=your-glm-api-key
MODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
MODEL_TEMPERATURE=0
MODEL_REQUEST_TIMEOUT=60
MODEL_MAX_RETRIES=1

# API 持久化检查点位置
CHECKPOINT_DB_PATH=.runtime/checkpoints.sqlite

# 数据后端默认保持 mock；按领域渐进切换。
ENTITY_BACKEND=milvus
ACHIEVEMENT_BACKEND=mock
GRAPH_BACKEND=mock

# MySQL gkx（密码只放本机 .env 或进程环境，绝不能提交）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=gkx
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password

# Neo4j
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j

# 第六阶段：Embedding 与 Milvus Lite Hybrid Search
EMBEDDING_PROVIDER=bge_m3
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
HF_HOME=.runtime/huggingface
EMBEDDING_CACHE_DIR=.runtime/huggingface
# 避免使用 pymilvus 自己占用的 MILVUS_URI；项目使用独立变量名。
GRAPHRAG_MILVUS_URI=.runtime/milvus-bge-m3.db
MILVUS_COLLECTION=scholar_entities
MILVUS_RRF_K=60
# Standalone/Zilliz Cloud 才需要 Token；Lite 留空。
MILVUS_TOKEN=
